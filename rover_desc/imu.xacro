<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- IMU Macro -->
    <xacro:macro name="imu_sensor" params="parent *origin">
        <!-- IMU Link -->
        <link name="imu_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.02 0.02 0.01"/>
                </geometry>
                <material name="imu_material">
                    <color rgba="0.7 0.7 0.7 1"/>
                </material>
            </visual>
            
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.02 0.02 0.01"/>
                </geometry>
            </collision>
            
            <inertial>
                <mass value="0.015"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="1.0e-6" ixy="0.0" ixz="0.0"
                         iyy="1.0e-6" iyz="0.0" 
                         izz="1.0e-6"/>
            </inertial>
        </link>

        <!-- IMU Joint -->
        <joint name="imu_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="imu_link"/>
            <xacro:insert_block name="origin"/>
        </joint>

    </xacro:macro>
</robot>
