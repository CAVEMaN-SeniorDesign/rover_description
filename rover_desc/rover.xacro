<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="rover">
    
    <!-- URDF & Visual -->
    <xacro:include filename="$(find rover_description)/rover_desc/parts/robot.urdf" />

    <xacro:include filename="$(find rover_description)/rover_desc/realsense.urdf" />
    <xacro:include filename="$(find rover_description)/rover_desc/realsense_links.xacro"/>


    <!-- Gazebo & Plugins all removed, these are all just to define joints and links -->
    <xacro:realsense_d435 parent="imager_3">
        <origin xyz="-0.0325 0 -0.005" rpy="${pi/2} ${pi/2} ${0}"/>
    </xacro:realsense_d435>

    <xacro:include filename="$(find rover_description)/rover_desc/imu.xacro" />
    <xacro:imu_sensor parent="rover_base">
        <origin xyz="0.28136771400569077217 -0.651070713998295858 0.42390609907984444504" rpy="0 0 0"/>
    </xacro:imu_sensor>
</robot>
